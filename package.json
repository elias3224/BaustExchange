{
  "name": "baust-exchange",
  "version": "1.0.0",
  "private": true,
  "description": "BAUST Exchange - a simple campus marketplace for buying, selling, exchanging and donating useful items.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "make-admin": "tsx scripts/make-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.19.3",
    "@types/date-fns": "^2.5.3",
    "@vercel/blob": "^2.8.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "^6.9.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
